rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== دوال مساعدة =====
    function signed() { return request.auth != null; }
    function mail() { return request.auth.token.email.lower(); }
    function isOwner() { return signed() && request.auth.token.email == 'alisalmankareem2@gmail.com' && request.auth.token.email_verified == true; }
    function isInstAdmin(inst) { return signed() && get(/databases/$(database)/documents/inst/$(inst)).data.adminUid == request.auth.uid; }

    // ===== الحسابات =====
    match /users/{uid} {
      allow read, write: if signed() && (request.auth.uid == uid || isOwner());
    }
    match /usernames/{h} {
      allow read: if signed();
      allow create, update: if signed() && request.resource.data.uid == request.auth.uid;
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    // ===== الباقات والاشتراكات والإعدادات =====
    match /plans/{id} {
      allow read: if signed();
      allow write: if isOwner();
    }
    match /config/{d} {
      allow read: if signed();
      allow write: if isOwner();
    }
    match /requests/{id} {
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow read: if isOwner() || (signed() && resource.data.uid == request.auth.uid);
      allow update, delete: if isOwner();
    }
    match /subscriptions/{uid} {
      allow read: if isOwner() || (signed() && request.auth.uid == uid);
      allow write: if isOwner();
    }
    match /feedbacks/{id} {
      allow create: if signed();
      allow read, update, delete: if isOwner();
    }
    match /posts/{id} {
      allow read, write: if signed();
    }

    // ===== المحادثات =====
    match /chats/{chatId} {
      allow read: if signed() && mail() in resource.data.members;
      allow create: if signed() && mail() in request.resource.data.members;
      allow update, delete: if signed() && mail() in resource.data.members;
      match /messages/{m} {
        allow read, write: if signed() && mail() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    // ===== المكالمات =====
    match /calls/{id=**} {
      allow read, write: if signed();
    }

    // ===== الامتحانات المباشرة =====
    match /live_quizzes/{pin} {
      allow read: if signed();
      allow create: if signed();
      allow update, delete: if signed() && resource.data.teacher == mail();
      match /answers/{a} {
        allow read: if signed() && (a == request.auth.uid || get(/databases/$(database)/documents/live_quizzes/$(pin)).data.teacher == mail());
        allow create, update: if signed();
        allow delete: if signed() && get(/databases/$(database)/documents/live_quizzes/$(pin)).data.teacher == mail();
      }
    }

    // ===== أولياء الأمور =====
    match /parent_cards/{code}/items/{i} {
      allow read, create: if signed();
    }

    // ===== المؤسسات والإدارة =====
    match /inst/{inst} {
      allow create: if signed() && request.resource.data.adminUid == request.auth.uid;
      allow read, update, delete: if signed() && resource.data.adminUid == request.auth.uid;
      match /reports/{r} {
        allow create: if signed();
        allow read: if isInstAdmin(inst);
      }
      match /private/{d} {
        allow read, write: if isInstAdmin(inst);
      }
    }

    // قائمة الطلاب الرسمية: معرّف الوثيقة سري، قراءة بالمعرّف فقط
    match /rosters/{rid} {
      allow get: if signed();
      allow create, update: if isInstAdmin(request.resource.data.inst);
    }

    // أكواد الطلاب
    match /student_codes/{code} {
      allow get: if signed();
      allow create, update: if isInstAdmin(request.resource.data.inst)
        || (signed()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','claimedAt'])
            && request.resource.data.uid == request.auth.uid
            && (!('uid' in resource.data) || resource.data.uid == request.auth.uid));
    }

    // كلاسات الأساتذة المنشورة للطلاب
    match /classes_pub/{code} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.tEmail == request.auth.token.email;
      allow update: if signed() && resource.data.tEmail == request.auth.token.email;
    }
  }
}
